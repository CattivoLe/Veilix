<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      App theme. Uses a Material parent and configures both the cold-start
      window background (API < 31) AND the Android 12+ splash screen API
      attributes so the launcher icon flashes on brand indigo, not on
      system white.

      Keep in sync with `cattivole.veilix.ui.theme.BrandColors`.
    -->
    <style name="Theme.Veilix" parent="android:Theme.Material.NoActionBar">
        <!-- Pre-API-31 / fallback window background -->
        <item name="android:windowBackground">@color/veilix_bg_top</item>

        <!-- Android 12+ SplashScreen API -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/veilix_bg_top</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher</item>

        <!-- System bar colors so status / nav blend with the gradient -->
        <item name="android:statusBarColor">@color/veilix_bg_top</item>
        <item name="android:navigationBarColor">@color/veilix_bg_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
