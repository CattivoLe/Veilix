    <string name="status_cannot_carry_data">Hiding your own message? Go ahead: the result is saved as PNG. But a %1$s image received from someone can\'t contain a message: compression destroys it, so ask them to send the image as a file.</string>
    <string name="status_save_password">Save this password somewhere safe. Without it, the message can\'t be recovered.</string>
    <string name="status_secrets_cleared">Password and secret data were cleared after inactivity.</string>
    <string name="capacity_detectable">Large payloads are easier to detect. For better stealth, use a larger image or hide less.</string>
    <string name="error_wrong_password_or_no_data">Wrong password, or this image has no hidden data. Images sent as photos through messengers lose it.</string>
    <string name="error_passwords_dont_match">The passwords don\'t match. Nothing was embedded.</string>
    <string name="export_zip_hint">For messengers: a ZIP file is delivered as is, without compression. Veilix opens it directly.</string>
