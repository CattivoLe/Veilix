    <!-- InfoPopover -->
    <string name="info_more">More info</string>
    <string name="info_close">Close</string>
    <string name="info_encryption_summary">Protects hidden data from being read without a password. Without it, anyone who opens the image in Veilix can extract the contents.</string>
    <string name="info_compression_summary">Shrinks the payload before encryption — fewer LSB bits used, less detectable, room for larger files.</string>
    <string name="info_image_size_summary">Limits the long edge before embedding. Bigger images carry more, but the exported PNG grows fast.</string>

    <!-- Encryption algorithm descriptions -->
    <string name="enc_none_desc">Data is embedded as-is with a visible marker — anyone can find and extract it.</string>
    <string name="enc_aes_desc">Industry standard, hardware acceleration on most devices.</string>
    <string name="enc_chacha_desc">Modern cipher, efficient without AES hardware.</string>
    <string name="enc_chacha_note">On Android available from API 28 (Android 9). Earlier versions need Tink/Conscrypt.</string>

    <!-- Compression algorithm descriptions -->
    <string name="comp_none_desc">No compression — uses more LSB bits.</string>
    <string name="comp_zlib_desc">Universal, balanced speed and ratio.</string>
    <string name="comp_lzfse_desc">Optimized by Apple: faster than zlib, denser.</string>
    <string name="comp_lzfse_note">Apple proprietary format. Not yet supported on Android — messages compressed with LZFSE on iOS cannot be opened here.</string>
    <string name="comp_lzma_desc">Maximum compression, slowest.</string>
    <string name="comp_lzma_note">Not yet supported on Android — needs the org.tukaani:xz library.</string>

    <!-- Image-size descriptions -->
    <string name="size_compact_desc">Tiny exports (~1 MB), modest capacity (~170 KB).</string>
    <string name="size_standard_desc">Sweet spot: ~3–5 MB exports, ~700 KB capacity.</string>
    <string name="size_large_desc">Heavier exports (~10–15 MB), ~2.7 MB capacity.</string>
    <string name="size_original_desc">Keeps native resolution. Exports can grow to 30–50 MB.</string>

    <!-- Export warning -->
    <string name="export_warning_title">Send as a file</string>
    <string name="export_warning_body">The image is saved as a PNG file in Downloads/Veilix. Send it as a file — by email, through cloud storage, or as a ZIP. Messengers and social networks recompress photos and destroy the hidden data.</string>
    <string name="export_dont_show_again">Don\'t show again</string>
    <string name="export_cancel">Cancel</string>
    <string name="export_continue">Continue</string>

